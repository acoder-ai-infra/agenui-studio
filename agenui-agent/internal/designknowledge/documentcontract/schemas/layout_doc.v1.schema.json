{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenui://schemas/layout_doc.v1",
  "type": "object",
  "required": ["documentSchema", "id", "version", "kind", "title", "summary", "layout"],
  "properties": {
    "documentSchema": {"const": "layout_doc.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "kind": {"const": "layout"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "layout": {
      "type": "object",
      "required": ["nodes"],
      "properties": {"nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type"]}}}
    }
  }
}
