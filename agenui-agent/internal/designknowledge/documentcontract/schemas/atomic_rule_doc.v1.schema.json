{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenui://schemas/atomic_rule_doc.v1",
  "type": "object",
  "required": ["documentSchema", "id", "version", "kind", "title", "summary", "rules"],
  "properties": {
    "documentSchema": {"const": "atomic_rule_doc.v1"}, "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1}, "kind": {"const": "rule"},
    "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "target", "strength", "effect", "sourceTrace"], "properties": {"strength": {"enum": ["required", "recommended", "optional", "forbidden"]}}}}
  }
}
